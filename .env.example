# Copy to .env before running `docker compose up`.

# --- Reward rule (README n / x) ---
# Every COUPON_ORDER_INTERVAL-th successful order makes one coupon available,
# for COUPON_PERCENT percent off.
COUPON_ORDER_INTERVAL=5
COUPON_PERCENT=10

# --- Admin boundary ---
# Sent as the `X-Admin-Token` header on /admin/* operations. Auth is not
# implemented (see DECISIONS.md); this only marks admin operations.
ADMIN_TOKEN=dev-admin-token

# --- Database (used by the backend container) ---
DATABASE_URL=postgresql+asyncpg://uniblox:uniblox@db:5432/uniblox

# --- Postgres container ---
POSTGRES_USER=uniblox
POSTGRES_PASSWORD=uniblox
POSTGRES_DB=uniblox
